{
  "info": {
    "name": "Assistência Técnica - Sprint 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "equipamentoId",
      "value": ""
    },
    {
      "key": "emailTeste",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Cadastrar cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/clientes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Cliente de Teste\",\n  \"email\": \"{{emailTeste}}\",\n  \"telefone\": \"(42) 99999-0000\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"emailTeste\", \"cliente.\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"clienteId\", String(pm.response.json().id));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Consultar cliente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/clientes/{{clienteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
